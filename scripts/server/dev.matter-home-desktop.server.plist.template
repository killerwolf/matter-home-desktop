<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Service launchd du serveur Matter Home (LaunchDaemon) : démarre avec le Mac, sans session
  ouverte, sous le compte de l'utilisateur qui l'a installé (jamais root).
  Gabarit rempli par install.sh : les champs écrits en capitales entre doubles soulignés sont
  remplacés, rien n'est à modifier ici.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <!-- Le dossier de données est donné explicitement : le service ne dépend pas de HOME.
       L'option require-identity évite toute nouvelle identité Matter par accident (code 78
       sans identité : « matter-home-server import » ou « init » d'abord).
       L'option log-file écrit un journal à droits restreints, avec rotation (5 Mo, 3 anciens
       fichiers). -->
  <key>ProgramArguments</key>
  <array>
    <string>__BINARY__</string>
    <string>--data-dir</string>
    <string>__DATA_DIR__</string>
    <string>--require-identity</string>
    <string>--log-file</string>
    <string>__LOG_FILE__</string>
  </array>

  <!-- Exécuté sous l'utilisateur d'installation : un LaunchDaemon sans UserName tournerait en
       root. -->
  <key>UserName</key>
  <string>__USER__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Relancé quand la sortie n'est pas un succès : erreur fatale, panique, import appliqué
       (code 75), identité absente. Un arrêt demandé (code 0) n'est pas relancé. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <!-- Au plus un lancement toutes les 30 s : une erreur persistante ne sature ni le Mac ni le
       journal. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- L'arrêt ordonné du serveur prend jusqu'à 10 s. -->
  <key>ExitTimeOut</key>
  <integer>20</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>info,matc=warn</string>
  </dict>

  <!-- Journal de secours : seulement ce qui s'affiche avant que le journal normal soit ouvert
       (erreur d'usage, plantage). Fichier créé en 0600 par install.sh. -->
  <key>StandardOutPath</key>
  <string>__FALLBACK_LOG__</string>
  <key>StandardErrorPath</key>
  <string>__FALLBACK_LOG__</string>
</dict>
</plist>
