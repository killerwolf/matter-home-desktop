{
  "meta": {
    "version": 1,
    "comment": "Source de vérité du design : lue par le client egui (crates/client/src/ui/theme.rs, include_str!) et par design/tokens.css, généré (cargo run -p matter-home-desktop --example tokens_css) pour la future app web mobile (ticket n° 15). Voir docs/design-system.md. Tout ce qui est sous « meta » est ignoré par les deux.",
    "temperature_comment": "Cinq paliers de 2 °C. Un palier couvre la moitié de l'intervalle de chaque côté de sa valeur : 16 ou moins = bleu, 24 ou plus = rouge. Mêmes teintes en clair et en sombre : elles se posent en aplat transparent (fill_alpha) sous le texte. no_sensor est dans les couleurs de chaque thème.",
    "state_comment": "state désigne une couleur de colors par son nom."
  },
  "colors": {
    "light": {
      "bg": "#f6f5f2",
      "surface": "#ffffff",
      "surface_alt": "#ecebe7",
      "line": "#dcdad4",
      "text": "#1d1f23",
      "text_secondary": "#62676f",
      "accent": "#0b6a94",
      "accent_soft": "#e2f0f6",
      "accent_text": "#0b6a94",
      "on_accent": "#ffffff",
      "ok": "#1f8f4e",
      "warn": "#b3590a",
      "on_warn": "#ffffff",
      "error": "#c4372c",
      "banner_warn": "#fbe3c6",
      "banner_info": "#f5ecc0",
      "no_sensor": "#d9d7d1",
      "series_temperature": "#c8431a",
      "series_humidity": "#1f6fc0",
      "series_power": "#7a4cc8",
      "series_cover": "#1f6fc0"
    },
    "dark": {
      "bg": "#1b1b1b",
      "surface": "#242424",
      "surface_alt": "#2c2c2c",
      "line": "#3a3a3a",
      "text": "#e6e6e6",
      "text_secondary": "#9a9a9a",
      "accent": "#0b5a80",
      "accent_soft": "#12303d",
      "accent_text": "#58b4dc",
      "on_accent": "#ffffff",
      "ok": "#2fb260",
      "warn": "#e8853a",
      "on_warn": "#1b1b1b",
      "error": "#f0623a",
      "banner_warn": "#5a3214",
      "banner_info": "#5a4614",
      "no_sensor": "#2c2c2c",
      "series_temperature": "#e65a32",
      "series_humidity": "#3c8cdc",
      "series_power": "#9664e6",
      "series_cover": "#3c8cdc"
    }
  },
  "temperature": {
    "unit": "°C",
    "step": 2,
    "fill_alpha": 0.28,
    "stops": [
      { "at": 16, "color": "#3b7fc4" },
      { "at": 18, "color": "#4f9fc0" },
      { "at": 20, "color": "#c9a94a" },
      { "at": 22, "color": "#e0703a" },
      { "at": 24, "color": "#d0483a" }
    ]
  },
  "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "radius": { "sm": 4, "md": 6, "lg": 8 },
  "size": {
    "row": 30,
    "dot": 7,
    "control": 24,
    "item_gap_y": 6,
    "button_pad_x": 10,
    "button_pad_y": 3
  },
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "weight": { "normal": 400, "strong": 600 },
    "line_height": 1.4,
    "size": { "caption": 11, "body": 13, "title": 15, "heading": 18, "display": 26 }
  },
  "state": { "hover": "surface_alt", "selected": "accent_soft" }
}
